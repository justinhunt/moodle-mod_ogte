{{!
    @template mod_ogte/generator_result

    A generated text, its keywords and how it meets the level's targets.

    Context variables required for this template:
    * title, html, words, levellabel, glossary, rows, notes - From mod_ogte_generate_text.
    * summary - The settings, e.g. NGSL 1.2 · Level 3 (A2) · about 300 words.
    * glossarycount, hasnotes - For the sections.

    Example context (json):
    {
        "summary": "NGSL 1.2 (General English) · Level 3 (A2) · about 300 words",
        "title": "The Map in the Attic",
        "words": 302,
        "levellabel": "Level 3 (A2)",
        "html": "<p>Mia was bored. It was raining.</p>",
        "glossary": [{"word": "attic", "explanation": "a room at the top of a house, under the roof"}],
        "glossarycount": 1,
        "rows": [{"measure": "Coverage at Level 3 (A2)", "value": "98.7%", "target": "95% or more",
                  "ismet": true, "isnotmet": false}],
        "notes": [],
        "hasnotes": false
    }
}}
<div class="ogte-gen-resulthead d-flex flex-wrap align-items-center justify-content-between p-3 mb-4">
    <div>
        <div class="text-primary small">{{#str}}gen_ready, mod_ogte{{/str}}</div>
        <h4 class="mb-0">{{summary}}</h4>
    </div>
    <div class="mt-2 mt-md-0">
        <button type="button" class="btn btn-outline-primary ogte-gen-change mr-2 me-2">{{#str}}gen_change, mod_ogte{{/str}}</button>
        <button type="button" class="btn btn-primary ogte-gen-again">{{#str}}gen_again, mod_ogte{{/str}}</button>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 mb-3">
        <div class="ogte-gen-textbox">
            <h4 class="mb-1">{{title}}</h4>
            <div class="text-muted small mb-3">{{#str}}gen_wordcount, mod_ogte, {"words": {{words}}, "level": {{#quote}}{{levellabel}}{{/quote}} }{{/str}}</div>
            {{{html}}}
        </div>
    </div>
    <div class="col-lg-4">
        {{#glossarycount}}
        <div class="ogte-gen-panel p-3 mb-3">
            <h5 class="mb-0">{{#str}}gen_keywords, mod_ogte{{/str}}</h5>
            <p class="text-muted small">{{#str}}gen_keywords_pre, mod_ogte{{/str}}</p>
            <dl class="mb-0">
                {{#glossary}}
                <dt><mark class="ogte-glossary-word">{{word}}</mark></dt>
                <dd>{{explanation}}</dd>
                {{/glossary}}
            </dl>
        </div>
        {{/glossarycount}}
        <div class="ogte-gen-panel ogte-gen-figures p-3 mb-3">
            <h5>{{#str}}gen_figures, mod_ogte{{/str}}</h5>
            <table class="table table-sm mb-2">
                <tbody>
                    {{#rows}}
                    <tr>
                        <th scope="row" class="font-weight-normal fw-normal">{{measure}}<div class="text-muted small">{{target}}</div></th>
                        <td class="text-right text-end text-nowrap">
                            {{#ismet}}<span class="text-success font-weight-bold fw-bold">{{value}} <i class="fa fa-check" title="{{#str}}rw_met, mod_ogte{{/str}}"></i><span class="sr-only visually-hidden">{{#str}}rw_met, mod_ogte{{/str}}</span></span>{{/ismet}}
                            {{#isnotmet}}<span class="text-warning font-weight-bold fw-bold">{{value}} <i class="fa fa-exclamation-circle" title="{{#str}}rw_notmet, mod_ogte{{/str}}"></i><span class="sr-only visually-hidden">{{#str}}rw_notmet, mod_ogte{{/str}}</span></span>{{/isnotmet}}
                            {{^ismet}}{{^isnotmet}}<span class="font-weight-bold fw-bold">{{value}}</span>{{/isnotmet}}{{/ismet}}
                        </td>
                    </tr>
                    {{/rows}}
                </tbody>
            </table>
            <p class="text-muted small mb-0">{{#str}}gen_figures_note, mod_ogte{{/str}}</p>
        </div>
        {{#hasnotes}}
        <div class="alert alert-warning">
            <h5>{{#str}}rw_notes, mod_ogte{{/str}}</h5>
            <ul class="mb-0">
                {{#notes}}<li>{{text}}</li>{{/notes}}
            </ul>
        </div>
        {{/hasnotes}}
    </div>
</div>
