{{!
    @template mod_ogte/articlerewriter

    The Text Rewriter: analyse a passage against a word list's levels, then simplify it to one.
    The analysis and the result are rendered by mod_ogte/rewriter.

    Context variables required for this template:
    * ogteid - The activity id.
    * aiavailable - Is an AI provider set up.
    * listoptions - The word lists, each with key and label.

    Example context (json):
    {
        "ogteid": 1,
        "aiavailable": true,
        "listoptions": [{"key": 1, "label": "NGSL 1.2 (General English)"}]
    }
}}
<div class="container ogte-rewriter" id="{{uniqid}}_rewriter">
    <h3 class="ogte-section-title">{{#str}}articlerewriter, mod_ogte{{/str}}</h3>
    <p class="ogte-panel-instructions">{{#str}}articlerewrite_instructions, mod_ogte{{/str}}</p>

    <ol class="ogte-rw-steps list-unstyled d-flex flex-wrap">
        <li class="ogte-rw-step ogte-rw-step-active" data-step="1"><span class="ogte-rw-stepnumber">1</span>{{#str}}rw_step1, mod_ogte{{/str}}</li>
        <li class="ogte-rw-step" data-step="2"><span class="ogte-rw-stepnumber">2</span>{{#str}}rw_step2, mod_ogte{{/str}}</li>
    </ol>

    {{^aiavailable}}<div class="alert alert-warning">{{#str}}noaiprovider, mod_ogte{{/str}}</div>{{/aiavailable}}

    <div class="ogte-rw-input">
        {{! Shown once there is a rewrite to go back to. }}
        <div class="ogte-rw-back mb-3" style="display: none;">
            <button type="button" class="btn btn-outline-primary ogte-rw-backtoresult"><i class="fa fa-arrow-right mr-1 me-1"></i>{{#str}}rw_backtoresult, mod_ogte{{/str}}</button>
        </div>
        <div class="form-group mb-3">
            <label for="{{uniqid}}_rw_list" class="font-weight-bold fw-bold">{{#str}}rw_wordlist, mod_ogte{{/str}}</label>
            <select id="{{uniqid}}_rw_list" class="custom-select form-select ogte-rw-list">
                {{#listoptions}}<option value="{{key}}">{{label}}</option>{{/listoptions}}
            </select>
            {{^listoptions}}<div class="alert alert-warning">{{#str}}rw_nolists, mod_ogte{{/str}}</div>{{/listoptions}}
        </div>
        <label for="{{uniqid}}_rw_original" class="h4">{{#str}}rw_originaltext, mod_ogte{{/str}}</label>
        <textarea id="{{uniqid}}_rw_original" class="mod-ogte-textarea ogte-wide ogte-rw-original" placeholder="{{#str}}rw_pastehere, mod_ogte{{/str}}">{{passage}}</textarea>
        <div class="d-flex flex-wrap align-items-center mt-3">
            <button type="button" class="btn btn-primary btn-lg ogte-rw-analyse mr-3 me-3" {{^listoptions}}disabled{{/listoptions}}>{{#str}}rw_analyse, mod_ogte{{/str}}</button>
            <span class="text-muted">{{#str}}rw_analyse_help, mod_ogte{{/str}}</span>
        </div>
        <div class="ogte-rw-analysis mt-4" style="display: none;"></div>
    </div>

    <div class="ogte-rw-progress alert alert-info mt-4" style="display: none;" role="status" aria-live="polite">
        <i class="fa fa-spinner fa-spin mr-2 me-2"></i><span class="ogte-rw-progressmessage"></span>
    </div>

    <div class="ogte-rw-result mt-4" style="display: none;"></div>

    {{! The result actions stay on the page, so the Text Profiler's send button handler finds them. }}
    <div class="ogte-rw-actions" style="display: none;"><div class="d-flex flex-wrap mt-3">
        <textarea id="the_ar_result" class="d-none" aria-hidden="true"></textarea>
        <button type="button" class="btn btn-outline-secondary ogte-rw-copy mr-2 me-2 mb-2"><i class="fa fa-copy mr-1 me-1"></i>{{#str}}rw_copy, mod_ogte{{/str}}</button>
        <span class="ogte-rw-copied text-success align-self-center mr-2 me-2 mb-2" style="display: none;">{{#str}}copied, mod_ogte{{/str}}</span>
        <button type="button" class="btn btn-outline-secondary ogte-rw-download mr-2 me-2 mb-2"><i class="fa fa-download mr-1 me-1"></i>{{#str}}rw_download, mod_ogte{{/str}}</button>
        <a class="btn btn-outline-primary ogte_ar_sendtoeditor_button ml-auto ms-auto mb-2" role="button" tabindex="0" data-send-target="#the_ar_result">{{#str}}rw_sendtoprofiler, mod_ogte{{/str}}</a>
    </div></div>
</div>
{{#js}}
    require(['mod_ogte/rewriter'], function(rewriter) {
        rewriter.init('{{uniqid}}_rewriter', {{ogteid}}, {{#aiavailable}}true{{/aiavailable}}{{^aiavailable}}false{{/aiavailable}});
    });
{{/js}}
